# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# The feature that just went into beta (named in each invite)
FEATURE_NAME=Session Replay Filters

# Booking link put in every invite (Calendly, Cal.com, Luma...)
BOOKING_URL=https://cal.com/your-team/feedback-call

# Optional: pull active users straight from PostHog instead of a CSV
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_EVENT=beta_feature_used
POSTHOG_PROFILE_PROPERTY=profile_url

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
